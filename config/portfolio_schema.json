{
  "schema_version": "1.0.0",
  "holdings": {
    "columns": ["as_of_date", "security_code", "security_name", "quantity", "average_cost", "currency", "market_value", "target_weight", "notes"],
    "required": ["as_of_date", "security_code", "quantity", "average_cost", "currency"],
    "date_fields": ["as_of_date"],
    "nonnegative_number_fields": ["quantity", "average_cost", "market_value"],
    "ratio_fields": ["target_weight"]
  },
  "transactions": {
    "columns": ["trade_date", "security_code", "security_name", "side", "quantity", "price", "fees", "taxes", "currency", "notes"],
    "required": ["trade_date", "security_code", "side", "quantity", "price", "currency"],
    "date_fields": ["trade_date"],
    "nonnegative_number_fields": ["quantity", "price", "fees", "taxes"],
    "enum_fields": {"side": ["BUY", "SELL", "DIVIDEND", "SPLIT", "TRANSFER_IN", "TRANSFER_OUT"]}
  },
  "investment_card": {
    "required": ["security_code", "updated_at", "status", "thesis", "why_now", "key_assumptions", "thesis_breakers", "catalysts", "risks", "valuation_framework", "target_weight", "source_links"],
    "status_values": ["active", "watchlist", "closed"],
    "array_fields": ["key_assumptions", "thesis_breakers", "catalysts", "risks", "source_links"]
  }
}
