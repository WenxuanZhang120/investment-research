{
  "plan_version": "1.2.0",
  "display_name": "Codex 每日数据采集计划",
  "timezone": "Asia/Shanghai",
  "suggested_run_time": "19:00",
  "collector": "codex_agent",
  "investment_universe": "config/investment_universe.json",
  "collection_budget": "config/collection_budget.json",
  "monitoring_scope_resolver": "scripts/resolve_monitoring_collection_scope.py",
  "python_importer": "scripts/import_codex_collection.py",
  "python_pipeline": "scripts/run_daily_pipeline.py",
  "tool_response_boundary": "installed_skill_output",
  "principles": {
    "save_raw_before_processing": true,
    "raw_response_must_be_unmodified": true,
    "public_payload_safety_before_raw_write": true,
    "provider_openapi_direct_calls_allowed": false,
    "inbox_must_be_git_ignored": true,
    "guess_unknown_fields": false,
    "investment_judgment_allowed": false,
    "automatic_trading_allowed": false,
    "commit_only_after_validation": true
  },
  "tasks": [
    {
      "task_id": "daily_a_share_market",
      "display_name": "A股每日市场快照",
      "dataset_kind": "market",
      "tool": "hithink-market-query",
      "frequency": "trading_day",
      "query_template": "{trade_date}沪深主板A股，排除创业板、科创板和北交所，查询股票代码、股票简称、股票市场类型、上市日期、上市状态、开盘价（不复权）、最高价（不复权）、最低价（不复权）、收盘价（不复权）、成交量、成交额、总市值、市盈率(pe,ttm)，按股票代码升序排列",
      "complete_pagination_required": true,
      "response_contract": {
        "contract_version": 1,
        "require_configured_query": true,
        "ordered_pagination": {
          "query_marker": "按股票代码升序排列",
          "raw_code_fields": ["股票代码"],
          "direction": "ascending",
          "strict": true,
          "validate_page_boundaries": true
        }
      }
    },
    {
      "task_id": "nasdaq_sp500_etfs",
      "display_name": "纳斯达克100与标普500相关ETF",
      "dataset_kind": "etf",
      "tool": "hithink-etf-selector",
      "frequency": "trading_day",
      "query_template": "{trade_date}纳斯达克100ETF或标普500ETF，查询ETF代码、ETF简称、跟踪指数、基金类型、上市日期、上市状态、最新价、涨跌幅、成交量、成交额、基金规模、单位净值、溢价率、管理费率、托管费率、跟踪误差，按ETF代码升序排列",
      "complete_pagination_required": true,
      "separate_from_stock_financial_pipeline": true,
      "response_contract": {
        "contract_version": 1,
        "require_configured_query": true,
        "ordered_pagination": {
          "query_marker": "按ETF代码升序排列",
          "raw_code_fields": ["ETF代码", "基金代码"],
          "direction": "ascending",
          "strict": true,
          "validate_page_boundaries": true
        },
        "semantic_evidence": {
          "field": "chunks_info",
          "required_all_concept_groups": [
            ["纳斯达克100", "纳指100", "NASDAQ100"],
            ["标普500", "SP500", "S&P500"],
            ["ETF"]
          ],
          "forbidden_concepts": ["重仓概念"]
        }
      }
    },
    {
      "task_id": "p0_repurchase_announcements",
      "display_name": "P0公司最近七日股份回购公告",
      "dataset_kind": "announcements",
      "tool": "announcement-search",
      "frequency": "daily",
      "scope_type": "latest_p0",
      "priority": "P0",
      "target_batch_size": 25,
      "maximum_target_count": 50,
      "allowed_event_types": ["share_repurchase"],
      "query_template": "P0研究队列公司最近七日股份回购公告｜标的：{p0_security_list}",
      "requested_result_count": 20,
      "complete_pagination_required": false,
      "normalized_results_must_match_scope": true
    },
    {
      "task_id": "p0_company_news",
      "display_name": "P0公司最近七日重要新闻",
      "dataset_kind": "news",
      "tool": "news-search",
      "frequency": "daily",
      "scope_type": "latest_p0",
      "priority": "P0",
      "target_batch_size": 25,
      "maximum_target_count": 50,
      "query_template": "P0研究队列公司最近七日重要新闻｜标的：{p0_security_list}",
      "requested_result_count": 20,
      "complete_pagination_required": false,
      "normalized_results_must_match_scope": true
    },
    {
      "task_id": "china_macro_policy_news",
      "display_name": "中国宏观与资本市场政策",
      "dataset_kind": "news",
      "tool": "news-search",
      "frequency": "daily",
      "scope_type": "market_wide",
      "query_template": "最近三日中国宏观经济、国务院、央行、财政部、证监会、发改委重要政策及资本市场重大事件",
      "requested_result_count": 20,
      "complete_pagination_required": false
    },
    {
      "task_id": "global_macro_market_news",
      "display_name": "全球宏观与海外市场事件",
      "dataset_kind": "news",
      "tool": "news-search",
      "frequency": "daily",
      "scope_type": "market_wide",
      "query_template": "最近三日美联储、美国通胀就业、利率汇率、关税贸易、地缘政治及纳斯达克和标普500重大市场事件",
      "requested_result_count": 20,
      "complete_pagination_required": false
    },
    {
      "task_id": "industry_policy_news",
      "display_name": "重要行业政策与产业事件",
      "dataset_kind": "news",
      "tool": "news-search",
      "frequency": "daily",
      "scope_type": "market_wide",
      "query_template": "最近三日A股重要产业政策、行业监管、产业扶持及重大技术产业事件",
      "requested_result_count": 20,
      "complete_pagination_required": false
    },
    {
      "task_id": "financial_plan_follow_up",
      "display_name": "财务批次缺口检查与续采",
      "dataset_kind": "financial",
      "tool": "hithink-finance-query",
      "frequency": "daily_if_incomplete",
      "query_source": "config/financial_collection_plan.json",
      "complete_pagination_required": true,
      "response_contract": {
        "contract_version": 1,
        "ordered_pagination": {
          "query_marker": "按股票代码升序排列",
          "raw_code_fields": ["股票代码"],
          "direction": "ascending",
          "strict": true,
          "validate_page_boundaries": true
        }
      }
    }
  ]
}
