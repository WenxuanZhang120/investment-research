{
  "pipeline_version": "1.2.0",
  "purpose": "deterministic_daily_orchestration",
  "llm_calls_allowed": false,
  "external_collection_enabled": false,
  "input_readiness": {
    "schema_version": 1,
    "financial_collection_plan": "config/financial_collection_plan.json",
    "investment_universe": "config/investment_universe.json",
    "raw_root": "data/raw",
    "mapping_file": "config/field_mappings.json",
    "normalized_root": "data/normalized",
    "derived_root": "data/derived",
    "basic_metric_config": "config/financial_metrics.json",
    "advanced_metric_config": "config/advanced_financial_metrics.json",
    "normalization_job_ids": [
      "2026q1_base_resume",
      "2024fy_advanced_inputs",
      "2025fy_advanced_supplement",
      "2025q1_advanced_inputs",
      "2026q1_advanced_supplement"
    ],
    "basic_metric_job_ids": [
      "2026q1_base_resume"
    ],
    "advanced_metric_job_ids": [
      "2024fy_advanced_inputs",
      "2025fy_advanced_supplement",
      "2025q1_advanced_inputs",
      "2026q1_advanced_supplement"
    ],
    "timeout_seconds": 900
  },
  "research_readiness": {
    "schema_version": 1,
    "raw_root": "data/raw",
    "normalized_root": "data/normalized",
    "derived_root": "data/derived",
    "reports_root": "reports/daily",
    "event_taxonomy": "config/event_taxonomy.json",
    "screening_rules": "config/screening_rules.json",
    "investment_universe": "config/investment_universe.json",
    "minimum_screening_universe": 3000,
    "timeout_seconds": 900,
    "monitoring_routes": [
      {
        "route_id": "p0_share_repurchase_announcements",
        "stream": "announcements",
        "query_prefix": "P0研究队列公司最近七日股份回购公告｜标的："
      },
      {
        "route_id": "p0_important_company_news",
        "stream": "news",
        "query_prefix": "P0研究队列公司最近七日重要新闻｜标的："
      },
      {
        "route_id": "china_macro_policy_news",
        "stream": "news",
        "query": "最近三日中国宏观经济、国务院、央行、财政部、证监会、发改委重要政策及资本市场重大事件"
      },
      {
        "route_id": "global_macro_market_news",
        "stream": "news",
        "query": "最近三日美联储、美国通胀就业、利率汇率、关税贸易、地缘政治及纳斯达克和标普500重大市场事件"
      },
      {
        "route_id": "industry_policy_news",
        "stream": "news",
        "query": "最近三日A股重要产业政策、行业监管、产业扶持及重大技术产业事件"
      }
    ]
  },
  "stages": [
    {
      "stage": "status",
      "steps": [
        {
          "step_id": "financial_collection_status",
          "command": [
            "scripts/run_financial_collection_plan.py",
            "status"
          ],
          "timeout_seconds": 120
        }
      ]
    },
    {
      "stage": "normalization",
      "steps": []
    },
    {
      "stage": "derivation",
      "steps": []
    },
    {
      "stage": "reporting",
      "steps": [
        {
          "step_id": "system_completion_audit",
          "command": [
            "scripts/audit_system_completion.py"
          ],
          "timeout_seconds": 300
        }
      ]
    },
    {
      "stage": "validation",
      "steps": [
        {
          "step_id": "repository_integrity",
          "command": [
            "scripts/validate_repository.py"
          ],
          "timeout_seconds": 300
        }
      ]
    }
  ]
}
